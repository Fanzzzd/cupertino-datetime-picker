{
  "name": "cupertino-datetime-picker",
  "version": "0.1.0",
  "description": "iOS-style compact date & time picker for React: an inline calendar with month/year wheels, and time wheels that also take typing. Built for shadcn/ui on Base UI.",
  "keywords": [
    "base-ui",
    "cupertino",
    "date-picker",
    "datetime-picker",
    "ios",
    "react",
    "shadcn",
    "tailwind",
    "time-picker",
    "wheel-picker"
  ],
  "homepage": "https://cupertino-datetime-picker-docs.vercel.app",
  "bugs": {
    "url": "https://github.com/fanzzzd/cupertino-datetime-picker/issues"
  },
  "license": "MIT",
  "author": "fanzzzd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fanzzzd/cupertino-datetime-picker.git"
  },
  "files": [
    "dist",
    "src",
    "registry.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsdown",
    "build:demo": "vite build",
    "registry:build": "shadcn build -o ../../docs/public/r",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint:package": "publint --strict && attw --pack --profile esm-only --exclude-entrypoints ./styles.css",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm lint:package",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@base-ui/react": "1.8.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "publint": "^0.3.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "peerDependencies": {
    "@base-ui/react": ">=1.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
